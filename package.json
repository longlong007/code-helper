{
  "name": "coding-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop programming assistant with floating ball and IDE context bridge",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @coding-helper/desktop dev",
    "dev:desktop": "pnpm --filter @coding-helper/desktop dev",
    "package:desktop": "pnpm --filter @coding-helper/desktop package",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0"
}
